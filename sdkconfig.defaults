# ESP32-S3, 8 MB flash, no PSRAM. The engine needs no PSRAM; nothing here should try.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=n
# 240 MHz and both cores: core 1 is the audio deadline, core 0 the UI.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_UNICORE=n
# The audio task must not be starved by the IDF's housekeeping.
CONFIG_FREERTOS_HZ=1000
# Smaller, faster boot: no verbose logging in release builds.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# The engine renders in a task, so flash cache misses during I2S are already handled by
# the DMA; keep the interrupt watchdog generous enough for an ES8311 write at boot.
CONFIG_ESP_INT_WDT_TIMEOUT_MS=800
